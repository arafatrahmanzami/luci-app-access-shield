# ARP ROSD Shield — main configuration
# Everything disabled by default. Nothing runs until user enables it.

config global 'settings'
    # ─── Master + feature toggles ─────────────────────────────────
    option enabled           '0'      # MASTER SWITCH — off by default
    option arp               '1'      # kernel ARP locks (nftables whitelist)
    option dhcp              '1'      # static DHCP lease mirroring
    option admin             '1'      # admin self-safeguard (cannot disable via UI)
    option rogue             '1'      # rogue DHCP shield
    option discovery         '1'      # live device discovery
    option firewall          '0'      # per-device internet block
    option wireless          '0'      # per-SSID MAC filter management
    option bandwidth         '0'      # bandwidth monitoring

    # ─── Compatibility mode ───────────────────────────────────────
    # off       = silent (ignore other systems)
    # warn      = detect + show compatibility panel (default)
    # integrate = warn + skip duplicate work where safe
    option compat_mode       'warn'

    # ─── Interface defaults ───────────────────────────────────────
    option default_iface     'br-lan2'
    option exclude_ifaces    'bat0 tailscale0 pppoe-wan eth1macvlan1 lan1macvlan0'

    # ─── UI preferences ───────────────────────────────────────────
    option scan_interval     '10'
    option bandwidth_interval '2'

    # ─── Flow offload restore state ───────────────────────────────
    option saved_flow_sw     ''
    option saved_flow_hw     ''
    option flow_restore_ask  '1'
