#!/bin/sh /etc/rc.common
START=94
STOP=12
USE_PROCD=1
. /lib/functions.sh

CFG="access_shield"
TAG="access-shield-stats"
NFT_TABLE="access_shield_stats"
LEASES="/tmp/dhcp.leases"

log() { logger -t "$TAG" "$*"; }

# Resolve current IPv4 for a MAC from DHCP leases
lookup_ip() {
    local mac="$1"
    [ -f "$LEASES" ] || return 0
    awk -v m="$mac" '$2 == m { print $3; exit }' "$LEASES"
}

rebuild_table() {
    nft delete table inet "$NFT_TABLE" 2>/dev/null
    nft add table inet "$NFT_TABLE" 2>/dev/null
    nft add chain inet "$NFT_TABLE" forward \
        "{ type filter hook forward priority -100 ; policy accept ; }" 2>/dev/null

    config_load "$CFG"

    local count=0 missing=0
    process_binding() {
        local section="$1" enabled mac
        config_get_bool enabled "$section" enabled 1
        config_get mac "$section" mac

        [ "$enabled" = "1" ] || return 0
        [ -n "$mac" ] || return 0

        mac=$(echo "$mac" | tr 'A-Z' 'a-z')
        local clean=$(echo "$mac" | tr -d ':')

        local ip=$(lookup_ip "$mac")
        if [ -z "$ip" ]; then
            log "no lease for $mac — skipped"
            missing=$((missing + 1))
            return 0
        fi

        # RX = FROM client (upload)
        nft add rule inet "$NFT_TABLE" forward \
            ip saddr "$ip" counter comment "rx_${clean}"
        # TX = TO client (download)
        nft add rule inet "$NFT_TABLE" forward \
            ip daddr "$ip" counter comment "tx_${clean}"

        count=$((count + 1))
    }
    config_foreach process_binding binding

    log "stats rebuilt: $count active, $missing without lease"
}

start_service() {
    [ "$(uci -q get $CFG.settings.enabled)" = "1" ] || return 0
    log "starting"
    rebuild_table
}

stop_service() {
    log "stopping"
    nft delete table inet "$NFT_TABLE" 2>/dev/null
}

reload_service() { stop_service; start_service; }

service_triggers() {
    procd_add_reload_trigger "$CFG"
}

status() {
    echo "=== access-shield-stats ==="
    nft list table inet "$NFT_TABLE" 2>/dev/null | grep -c counter
    echo "  counters"
}
extra_command "status" "Show stats counters"
