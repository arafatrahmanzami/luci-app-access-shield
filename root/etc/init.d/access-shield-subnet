#!/bin/sh /etc/rc.common
START=98
STOP=7
USE_PROCD=1
. /lib/functions.sh

CFG="access_shield"
TAG="access-shield-subnet"
NFT_TABLE="access_shield_subnet"

log() { logger -t "$TAG" "$*"; }

purge_subnet() {
    nft delete table inet "$NFT_TABLE" 2>/dev/null
    log "purged subnet table"
}

unit_to_bytes_per_sec() {
    local val="$1" unit="$2"
    awk -v v="$val" -v u="$unit" 'BEGIN {
        n = v + 0
        if (n <= 0) { print 0; exit }
        if (u == "MBps")       bps = n * 1000000
        else if (u == "Kbps")  bps = n * 125
        else if (u == "KBps")  bps = n * 1000
        else                   bps = n * 125000
        printf "%d", bps
    }'
}

apply_subnets() {
    local count=0

    nft add table inet "$NFT_TABLE" 2>/dev/null
    nft add chain inet "$NFT_TABLE" forward \
        "{ type filter hook forward priority 15 ; policy accept ; }" 2>/dev/null

    config_load "$CFG"

    process_subnet() {
        local section="$1" enabled label cidr device dlv dlu ulv ulu clean
        config_get_bool enabled "$section" enabled 1
        config_get label "$section" label
        config_get cidr "$section" cidr
        config_get device "$section" device
        config_get dlv "$section" dl_val
        config_get dlu "$section" dl_unit
        config_get ulv "$section" ul_val
        config_get ulu "$section" ul_unit

        [ "$enabled" = "1" ] || return 0
        [ -n "$cidr" ] || return 0

        clean=$(echo "$cidr" | tr '/.' '__')

        if [ -n "$dlv" ]; then
            bps=$(unit_to_bytes_per_sec "$dlv" "$dlu")
            if [ "$bps" -gt 0 ]; then
                nft add rule inet "$NFT_TABLE" forward \
                    ip daddr "$cidr" limit rate over "${bps} bytes/second" \
                    counter drop comment "access_shield_subnet_dl_${clean}"
                log "DL: $cidr ≤ ${dlv} ${dlu} (${bps} B/s)"
                count=$((count + 1))
            fi
        fi

        if [ -n "$ulv" ]; then
            bps=$(unit_to_bytes_per_sec "$ulv" "$ulu")
            if [ "$bps" -gt 0 ]; then
                nft add rule inet "$NFT_TABLE" forward \
                    ip saddr "$cidr" limit rate over "${bps} bytes/second" \
                    counter drop comment "access_shield_subnet_ul_${clean}"
                log "UL: $cidr ≤ ${ulv} ${ulu} (${bps} B/s)"
                count=$((count + 1))
            fi
        fi
    }
    config_foreach process_subnet subnet

    log "applied $count subnet rate rules"
}

start_service() {
    [ "$(uci -q get $CFG.settings.enabled)" = "1" ] || { log "master OFF"; return 0; }
    log "starting"
    purge_subnet
    apply_subnets
}

stop_service() { log "stopping"; purge_subnet; }
reload_service() { stop_service; start_service; }
service_triggers() { procd_add_reload_trigger "$CFG"; }

status() {
    echo "=== access-shield-subnet ==="
    echo "rules: $(nft list table inet $NFT_TABLE 2>/dev/null | grep -c 'drop')"
    nft list table inet "$NFT_TABLE" 2>/dev/null | grep "comment" | head -10
}
extra_command "status" "Show subnet shaping status"
