#!/bin/sh /etc/rc.common
START=99
STOP=5
USE_PROCD=1

TAG="access-shield-ticketd"
log() { logger -t "$TAG" "$*"; }

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c '
        while true; do
            now=$(date +%s)
            expired=0
            for s in $(uci show access_shield 2>/dev/null | grep "=ticket" | cut -d. -f2 | cut -d= -f1); do
                expires=$(uci -q get access_shield.$s.expires_at)
                [ -n "$expires" ] || continue
                if [ "$now" -ge "$expires" ]; then
                    logger -t access-shield-ticketd "expired: $s"
                    uci -q delete access_shield.$s
                    expired=$((expired + 1))
                fi
            done
            if [ "$expired" -gt 0 ]; then
                uci -q commit access_shield
                /etc/init.d/access-shield-block reload >/dev/null 2>&1
            fi
            sleep 10
        done
    '
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}

stop_service() { log "stopping"; }
