    if [ -z "$section" ]; then
        json_init; json_add_boolean "ok" 0; json_add_string "error" "not found"; json_dump; return
    fi

    uci -q set access_shield."$section".name="$name"
    uci -q commit access_shield
    /etc/init.d/access-shield reload >/dev/null 2>&1 &

