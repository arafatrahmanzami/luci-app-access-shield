#!/bin/sh
. /usr/share/libubox/jshn.sh

CFG="access_shield"
NFT_TABLE="access_shield_fw"

cfg() { uci -q get "$CFG".settings."$1"; }

list_bridges() {
    for d in /sys/class/net/*/bridge; do
        [ -d "$d" ] || continue
        basename "$(dirname "$d")"
    done
}

do_list_bridges() {
    json_init
    json_add_array "bridges"
    for iface in $(list_bridges); do
        subnet=$(ip -4 addr show "$iface" 2>/dev/null | awk '/inet /{print $2; exit}')
        state=$(cat /sys/class/net/"$iface"/operstate 2>/dev/null)
        rules=$(nft list chain inet "$NFT_TABLE" "${iface}_shield" 2>/dev/null | wc -l)
        json_add_object
        json_add_string "name"   "$iface"
        json_add_string "subnet" "$subnet"
        json_add_string "state"  "$state"
        json_add_int    "rules"  "$rules"
        json_close_object
    done
    json_close_array
    json_dump
}

do_status() {
    json_init
    json_add_string "enabled"     "$(cfg enabled)"
    json_add_string "compat_mode" "$(cfg compat_mode)"
    json_add_int    "bindings"    "$(uci show $CFG 2>/dev/null | grep -c '=binding')"
    json_add_int    "dhcp_mirror" "$(uci show dhcp 2>/dev/null | grep -c "allocated_by='$CFG'")"
    json_add_int    "admin_log"   "$(wc -l < /tmp/access_shield_admin_safeguard.log 2>/dev/null || echo 0)"
    json_dump
}

do_sync() {
    /etc/init.d/access-shield reload >/dev/null 2>&1 &
    json_init
    json_add_boolean "ok" 1
    json_dump
}

do_migrate_scan() {
    out=$(/usr/bin/access-shield-migrate scan)
    json_init
    json_add_string "result" "$out"
    json_dump
}

do_migrate_import() {
    out=$(/usr/bin/access-shield-migrate import)
    json_init
    json_add_boolean "ok" 1
    json_add_string "output" "$out"
    json_dump
}


do_bandwidth_stats() {
    json_init
    json_add_array "top"

    if [ -f /proc/net/nf_conntrack ]; then
        awk '
            {
                src = ""; bytes = 0
                for (i = 1; i <= NF; i++) {
                    if ($i ~ /^src=/) src = substr($i, 5)
                    if ($i ~ /^bytes=/) bytes = substr($i, 7) + 0
                }
                if (src != "" && bytes > 0) {
                    sum[src] += bytes
                    cnt[src] += 1
                }
            }
            END { for (ip in sum) printf "%s %d %d\n", ip, cnt[ip], sum[ip] }
        ' /proc/net/nf_conntrack 2>/dev/null | sort -k3 -rn | head -30 > /tmp/access_shield_bw.txt

        if [ -s /tmp/access_shield_bw.txt ]; then
            while read -r ip flows bytes; do
                [ -z "$ip" ] && continue
                json_add_object
                json_add_string "ip"    "$ip"
                json_add_int    "flows" "$flows"
                json_add_int    "bytes" "$bytes"
                json_close_object
            done < /tmp/access_shield_bw.txt
        fi
    fi

    json_close_array
    json_add_string "flow_offload_sw" "$(uci -q get firewall.@defaults[0].flow_offloading)"
    json_add_string "flow_offload_hw" "$(uci -q get firewall.@defaults[0].flow_offloading_hw)"
    json_dump
}

do_list_devices() {
    # Calls the standalone discover script and passes through JSON
    out=$(/usr/bin/access-shield-discover 2>/dev/null)
    if [ -z "$out" ]; then
        json_init
        json_add_array "devices"
        json_close_array
        json_dump
        return
    fi
    # The discover script outputs raw JSON — dump it directly
    printf '%s\n' "$out"
}

do_traffic_per_device() {
    out=$(/usr/bin/access-shield-traffic 2>/dev/null)
    if [ -z "$out" ]; then
        json_init
        json_add_int "interval" 1
        json_add_array "devices"
        json_close_array
        json_dump
        return
    fi
    printf '%s\n' "$out"
}

do_bind_device() {
    local mac ip iface name
    json_get_var mac   "mac"
    json_get_var ip    "ip"
    json_get_var iface "iface"
    json_get_var name  "name"

    mac=$(echo "$mac" | tr 'A-Z' 'a-z')
    [ -z "$mac" ] && { json_init; json_add_boolean "ok" 0; json_add_string "error" "mac required"; json_dump; return; }
    [ -z "$ip" ] && ip="0.0.0.0"
    [ -z "$iface" ] && iface="br-lan2"
    [ -z "$name" ] && name="device-$(echo "$mac" | tr -d ':')"

    section="dev_$(echo "$mac" | tr -d ':')"

    uci -q batch <<EOS
set access_shield.${section}=binding
set access_shield.${section}.enabled='1'
set access_shield.${section}.name='${name}'
set access_shield.${section}.iface='${iface}'
set access_shield.${section}.ip='${ip}'
set access_shield.${section}.mac='${mac}'
set access_shield.${section}.leasetime='infinite'
set access_shield.${section}.block_internet='0'
EOS
    uci -q commit access_shield
    /etc/init.d/access-shield reload >/dev/null 2>&1 &

    json_init
    json_add_boolean "ok" 1
    json_add_string "section" "$section"
    json_dump
}

do_unbind_device() {
    local mac section
    json_get_var mac "mac"
    mac=$(echo "$mac" | tr 'A-Z' 'a-z')

    section=""
    for s in $(uci show access_shield 2>/dev/null | grep '=binding' | cut -d. -f2 | cut -d= -f1); do
        bmac=$(uci -q get access_shield.$s.mac | tr 'A-Z' 'a-z')
        [ "$bmac" = "$mac" ] && { section="$s"; break; }
    done

    if [ -z "$section" ]; then
        json_init; json_add_boolean "ok" 0; json_add_string "error" "not found"; json_dump; return
    fi

    uci -q delete access_shield."$section"
    uci -q commit access_shield
    /etc/init.d/access-shield reload >/dev/null 2>&1 &

    json_init
    json_add_boolean "ok" 1
    json_dump
}

