do_wifi_interfaces() {
    json_init
    json_add_array "interfaces"
    for s in $(uci -q show wireless 2>/dev/null | grep -E "=['\'"]?wifi-iface['\'"]?" | cut -d. -f2 | cut -d= -f1 | tr -d "'\""); do
        [ -z "$s" ] && continue
        d=$(uci -q get wireless.$s.device 2>/dev/null)
        m=$(uci -q get wireless.$s.mode 2>/dev/null || echo "ap")
        ssid=$(uci -q get wireless.$s.ssid 2>/dev/null)
        disabled=$(uci -q get wireless.$s.disabled 2>/dev/null || echo "0")
        macfilter=$(uci -q get wireless.$s.macfilter 2>/dev/null || echo "disable")
        mlist=$(uci -q get wireless.$s.maclist 2>/dev/null)

        json_add_object
        json_add_string "section" "$s"
        json_add_string "device"  "$d"
        json_add_string "mode"    "$m"
        json_add_string "ssid"    "$ssid"
        json_add_string "disabled" "$disabled"
        json_add_string "macfilter" "$macfilter"

        json_add_array "maclist"
        for item in $mlist; do
            json_add_string "" "$item"
        done
        json_close_array
        json_close_object
    done
    json_close_array
    json_dump
}

do_set_mac_filter() {
    local section mac action
    json_get_var section "section"
    json_get_var mac "mac"
    json_get_var action "action"
    mac=$(echo "$mac" | tr 'a-z' 'A-Z')

    if [ -z "$section" ] || [ -z "$mac" ]; then
        json_init; json_add_boolean "ok" 0; json_add_string "error" "missing"; json_dump; return
    fi

    case "$action" in
        add)
            uci -q set wireless."$section".macfilter="allow"
            uci -q del_list wireless."$section".maclist="$mac" 2>/dev/null
            uci -q add_list wireless."$section".maclist="$mac"
            ;;
        remove)
            uci -q del_list wireless."$section".maclist="$mac" 2>/dev/null
            ;;
    esac
    uci -q commit wireless
    ( wifi reload >/dev/null 2>&1 & ) &

    json_init
    json_add_boolean "ok" 1
    json_dump
}

