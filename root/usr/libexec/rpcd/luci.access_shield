do_set_alias() {
    local ip name mac
    json_get_var ip   "ip"
    json_get_var name "name"
    json_get_var mac  "mac"

    [ -z "$ip" ] && { json_init; json_add_boolean "ok" 0; json_add_string "error" "ip required"; json_dump; return; }
    [ -z "$name" ] && { json_init; json_add_boolean "ok" 0; json_add_string "error" "name required"; json_dump; return; }

    # Sanitize: keep alnum, space, dot, dash, underscore, parens
    name=$(echo "$name" | tr -d '\n\r\t' | tr -cd 'a-zA-Z0-9 _.()-' | cut -c1-32)

    sec="alias_$(echo "$ip" | tr '.' '_')"

    uci -q batch <<EOS
set access_shield.${sec}=alias
set access_shield.${sec}.ip='${ip}'
set access_shield.${sec}.name='${name}'
set access_shield.${sec}.mac='${mac}'
EOS
    uci -q commit access_shield

    json_init
    json_add_boolean "ok" 1
    json_add_string "section" "$sec"
    json_dump
}

