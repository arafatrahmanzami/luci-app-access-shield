do_set_speed_limit() {
    local mac ip dl_val dl_unit ul_val ul_unit
    json_get_var mac     "mac"
    json_get_var ip      "ip"
    json_get_var dl_val  "dl_val"
    json_get_var dl_unit "dl_unit"
    json_get_var ul_val  "ul_val"
    json_get_var ul_unit "ul_unit"
    mac=$(echo "$mac" | tr 'a-z' 'A-Z')

    [ -z "$dl_val" ] && dl_val="0"
    [ -z "$dl_unit" ] && dl_unit="Mbps"
    [ -z "$ul_val" ] && ul_val="0"
    [ -z "$ul_unit" ] && ul_unit="Mbps"

    if [ -z "$mac" ]; then
        json_init; json_add_boolean "ok" 0; json_add_string "error" "mac required"; json_dump; return
    fi

    clean=$(echo "$mac" | tr -d ':' | tr 'A-Z' 'a-z')
    sec="limit_${clean}"

    has_dl=$(awk -v v="$dl_val" 'BEGIN { print (v+0 > 0) ? 1 : 0 }')
    has_ul=$(awk -v v="$ul_val" 'BEGIN { print (v+0 > 0) ? 1 : 0 }')

    uci -q delete access_shield."$sec" 2>/dev/null

    if [ "$has_dl" = "1" ] || [ "$has_ul" = "1" ]; then
        uci -q batch <<EOS
set access_shield.${sec}=limit
set access_shield.${sec}.mac='${mac}'
set access_shield.${sec}.ip='${ip}'
set access_shield.${sec}.dl_val='${dl_val}'
set access_shield.${sec}.dl_unit='${dl_unit}'
set access_shield.${sec}.ul_val='${ul_val}'
set access_shield.${sec}.ul_unit='${ul_unit}'
EOS
    fi
    uci -q commit access_shield

    /etc/init.d/access-shield-shape reload >/dev/null 2>&1 &

    json_init
    json_add_boolean "ok" 1
    json_dump
}

do_delete_speed_limit() {
